# Build context is ./frontend and the Dockerfile does `COPY . .`, so anything
# left here is baked into the image. .gitignore does NOT apply to Docker builds.

# Installed deps — Windows-native binaries break the Linux build; npm ci
# reinstalls from package-lock.json inside the image anyway (~160MB saved)
node_modules/
.pnpm-store/

# Build output — regenerated in the image
dist/
.vite/

# Env files are supplied by compose, not baked in
.env
.env.*
!.env.example

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.tsbuildinfo

.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db
