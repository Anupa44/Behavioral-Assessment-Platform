# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://bap_user:bap_password@db:5432/bap_db

# Redis
REDIS_URL=redis://redis:6379/0

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email — Google SMTP (use an App Password from https://myaccount.google.com/apppasswords)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# AI Provider — choose one: mock | openai | openrouter | gemini
# mock needs no API key and generates sample questions locally.
AI_PROVIDER=mock

# Optional: override the model for openai/openrouter
# AI_MODEL=google/gemini-2.0-flash-001

# If AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# If AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# If AI_PROVIDER=gemini
GEMINI_API_KEY=...

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
